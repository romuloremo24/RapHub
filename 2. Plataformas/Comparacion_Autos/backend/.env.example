# Copia este archivo a .env y llena los valores

# JWT – cambia esto en producción
SECRET_KEY=radarauto-dev-secret-change-in-production

# SMTP para envío de alertas por email
# Gmail: activa "Contraseñas de aplicación" en tu cuenta de Google
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password_aqui
