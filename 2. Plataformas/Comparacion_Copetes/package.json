{
  "name": "comparacopete-chile",
  "version": "1.0.0",
  "description": "Comparador de precios de tragos en Chile - scraping diario automático",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "scrape": "node -e \"const s=require('./scrapers'); s.scrapeAll(p=>process.stdout.write('\\rProgreso: '+p+'%')).then(()=>console.log('\\nListo!')).catch(console.error)\""
  },
  "dependencies": {
    "axios": "1.7.9",
    "cheerio": "1.0.0",
    "express": "4.21.2",
    "node-cron": "3.0.3",
    "puppeteer": "24.2.1"
  }
}
